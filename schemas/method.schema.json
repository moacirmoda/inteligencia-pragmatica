  "type": "object",
  "additionalProperties": false,
  "required": ["method", "severities", "phases", "transitions", "artifacts", "execution_skills", "routing", "quality_criteria"],
  "properties": {
    "method": {"type": "object"},
    "severities": {"type": "object"},
    "phases": {"type": "object"},
    "transitions": {"type": "array"},
    "artifacts": {"type": "object"},
    "execution_skills": {"type": "object"},
    "routing": {"type": "object"},
    "quality_criteria": {"type": "object"},
    "optional_by_context": {"type": "array"}
  }
}
